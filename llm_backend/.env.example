# Kopiér til .env og udfyld:  cp .env.example .env
# Værdier skrives uden anførselstegn og mellemrum (filen læses også af scripts).

# --- Sikkerhed (NFR-SEC-01) -----------------------------------------------
# Påkrævet. Generér fx med:  openssl rand -hex 32
LLM_A_API_KEY=
LLM_B_API_KEY=

# --- Porte (bindes altid kun til 127.0.0.1) --------------------------------
LLM_A_PORT=8081
LLM_B_PORT=8082

# --- Modeller ---------------------------------------------------------------
# Endpoint A: architect/lead
MODEL_A_FILE=qwen2.5-coder-3b-instruct-q4_k_m.gguf
MODEL_A_URL=https://huggingface.co/Qwen/Qwen2.5-Coder-3B-Instruct-GGUF/resolve/main/qwen2.5-coder-3b-instruct-q4_k_m.gguf
MODEL_A_ALIAS=qwen2.5-coder-3b

# Endpoint B: worker/tester
MODEL_B_FILE=qwen2.5-coder-1.5b-instruct-q4_k_m.gguf
MODEL_B_URL=https://huggingface.co/Qwen/Qwen2.5-Coder-1.5B-Instruct-GGUF/resolve/main/qwen2.5-coder-1.5b-instruct-q4_k_m.gguf
MODEL_B_ALIAS=qwen2.5-coder-1.5b

# Kun nødvendig for gated/private Hugging Face-repos.
HF_TOKEN=

# --- Inferens -----------------------------------------------------------------
LLM_CTX_SIZE=8192
# Øvre grænse for max_tokens pr. svar (større værdier i requests klippes ned).
LLM_A_MAX_TOKENS=2048
LLM_B_MAX_TOKENS=1024

# --- Diverse ------------------------------------------------------------------
# Ejer af de downloadede filer i ./models (din bruger: `id -u` / `id -g`).
HOST_UID=1000
HOST_GID=1000
# Pin gerne til et konkret build-tag for reproducerbarhed, fx ...:server-b6000
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server
CURL_IMAGE=curlimages/curl:latest
